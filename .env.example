# Copy to .env (./setup.sh does this for you) and edit as needed.
# Read by ./services.sh via --env-file and interpolated into
# docker-compose.override.yml.

# MariaDB root password.
# Only applied when the data volume is first created -- changing this later
# has no effect on an existing volume. frappe_docker's docs assume 123, e.g.
#   bench new-site --db-root-password 123 ...
MYSQL_ROOT_PASSWORD=123

# Host ports. These are what bench's common_site_config.json points at.
MYSQL_PORT=3306
REDIS_CACHE_PORT=13000
REDIS_QUEUE_PORT=11000
